<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Academic Center - <%= request.getAttribute("title") != null ? request.getAttribute("title") : "Management System" %></title>
        <link rel="stylesheet" href="css/style.css">
    <%-- Dynamically include additional CSS files --%>
    <%
        String additionalCss = (String) request.getAttribute("additionalCss");
        if (additionalCss != null && !additionalCss.isEmpty()) {
            String[] cssFiles = additionalCss.split(",");
            for (String cssFile : cssFiles) {
    %>
                <link rel="stylesheet" href="css/<%= cssFile.trim() %>.css">
    <%
            }
        }
    %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body>
    <header class="main-header">
        <div class="container">
            <div class="logo">Academic Center</div>
            <button class="hamburger-menu" aria-label="Toggle navigation">
                <i class="fas fa-bars"></i>
            </button>
            <nav class="main-nav">
                <ul>
                    <li><a href="dashboard.jsp"><i class="fas fa-tachometer-alt"></i> Dashboard</a></li>
                    <li><a href="student_profile.jsp"><i class="fas fa-user-graduate"></i> Student Profile</a></li>
                    <li><a href="view_grades.jsp"><i class="fas fa-chart-line"></i> View Grades</a></li>
                    <li><a href="view_attendance.jsp"><i class="fas fa-calendar-check"></i> View Attendance</a></li>
                    <li><a href="messages.jsp"><i class="fas fa-envelope"></i> Messages</a></li>
                    <li><a href="announcements.jsp"><i class="fas fa-bullhorn"></i> Announcements</a></li>
                    <li><a href="class_schedule.jsp"><i class="fas fa-calendar-alt"></i> Class Schedule</a></li>
                    <li><a href="teacher_list.jsp"><i class="fas fa-chalkboard-teacher"></i> Teacher List</a></li>
                    <li><a href="course_management.jsp"><i class="fas fa-book"></i> Course Management</a></li>
                    <li><a href="#"><i class="fas fa-user-circle"></i> Profile</a></li>
                    <li><a href="logout.jsp"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
                </ul>
            </nav>
        </div>
    </header>
    <main class="main-content">
        <div class="container">
